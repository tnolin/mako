# S3-compatible bucket for the off-site copy of the nightly bot dump. Write to /etc/ink/backup.env (0600, root).
# rclone's S3 provider name for your storage service; empty uses Other.
S3_PROVIDER=
# The service's S3 endpoint URL.
S3_ENDPOINT=
# Bucket name.
S3_BUCKET=
# A key that can only read and write this one bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
