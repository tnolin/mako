# Postgres with the indexer's `indexer` schema and the bot's `bot` schema.
# On the server: postgres:///ink with PGHOST=/var/run/postgresql and PGUSER=mako (peer auth, no password).
DATABASE_URL=
# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# InkyPump referral code for Trade links and the Trade on InkyPump link. Empty sends plain links.
INKYPUMP_REF_CODE=
# JSON-RPC endpoint for the one on-chain read (dev holds). Empty uses https://rpc-qnd.inkonchain.com.
INK_RPC_URL=
# Public base URL of the Trade redirect, e.g. https://go.makobot.xyz.
LINKS_BASE_URL=
# Local port of the redirect server (default 8080).
LINKS_PORT=
# Sentry DSN. Empty disables Sentry and the heartbeat check-in.
SENTRY_DSN=
# Release name reported to Sentry, normally the deployed git tag.
SENTRY_RELEASE=
# debug | info | warn | error (default info)
LOG_LEVEL=
# Unix seconds. NFT events with an earlier block time never alert (the indexer's NFT backfill writes old
# ones as new rows). Empty uses the time the bot first ran with NFT rules, stored in the database.
NFT_ALERTS_SINCE=
