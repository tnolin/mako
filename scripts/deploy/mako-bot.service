[Unit]
Description=MAKO Telegram bot
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=mako
Group=ink
WorkingDirectory=/opt/mako
EnvironmentFile=/etc/ink/mako.env
ExecStartPre=/usr/bin/node --import tsx src/migrate-cli.ts
ExecStart=/usr/bin/node --import tsx src/main.ts
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
