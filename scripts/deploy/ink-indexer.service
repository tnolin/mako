[Unit]
Description=ink-indexer: InkyPump events into Postgres
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ink-indexer
Group=ink
WorkingDirectory=/opt/ink-indexer
EnvironmentFile=/etc/ink/indexer.env
ExecStartPre=/usr/bin/node --import tsx packages/db/src/migrate-cli.ts
ExecStart=/usr/bin/node --import tsx apps/indexer/src/main.ts start
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
