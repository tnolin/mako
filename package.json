{
  "name": "mako",
  "version": "0.2.2",
  "private": true,
  "description": "Real-time Telegram alerts for Ink memecoins",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate-cli.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts"
  },
  "dependencies": {
    "@ink-indexer/events": "github:tnolin/ink-indexer#events-v2&path:/packages/events",
    "@sentry/node": "11.6.0",
    "grammy": "1.46.0",
    "postgres": "^3.4.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.4",
    "embedded-postgres": "18.4.0-beta.17",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
